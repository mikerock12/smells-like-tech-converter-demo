<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SmellsLikeTech.Converter.Engine.Music</RootNamespace>
    <Description>Criacao musical: audio em tempo real (WASAPI), gravacao multipista, mixagem, exportacao e separacao de faixas (ONNX Runtime).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio (MIT): WASAPI para tocar e gravar com baixa latencia. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmellsLikeTech.Converter.Core\SmellsLikeTech.Converter.Core.csproj" />
    <ProjectReference Include="..\SmellsLikeTech.Converter.Infrastructure\SmellsLikeTech.Converter.Infrastructure.csproj" />
    <ProjectReference Include="..\SmellsLikeTech.Converter.Engine.FFmpeg\SmellsLikeTech.Converter.Engine.FFmpeg.csproj" />
  </ItemGroup>
</Project>
