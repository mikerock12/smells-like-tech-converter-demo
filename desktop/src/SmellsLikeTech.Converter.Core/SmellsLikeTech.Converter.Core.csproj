<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SmellsLikeTech.Converter.Core</RootNamespace>
    <Description>Nucleo de conversao reutilizavel entre desktop, worker e nuvem.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Presets do estudio: a mesma fonte do site e do Android. -->
    <EmbeddedResource Include="..\..\..\packages\converter-core\estudio-presets.json" LogicalName="estudio-presets.json" Link="Studio\estudio-presets.json" />
    <EmbeddedResource Include="..\..\..\packages\converter-core\musica-catalogo\efeitos.json" LogicalName="musica-efeitos.json" Link="Music\efeitos.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(SltNativeDll)' != ''">
    <None Include="$(SltNativeDll)" Link="slt_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
