<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SmellsLikeTech.Converter.Infrastructure</RootNamespace>
    <Description>Arquivos, processos, SQLite, logs e hardware.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pinado acima da versao trazida por Microsoft.Data.Sqlite para evitar o aviso NU1903. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes trocam a espera entre tentativas de apagar a pasta do job por um gancho
         e soltam o arquivo preso exatamente entre uma tentativa e a seguinte. -->
    <InternalsVisibleTo Include="SmellsLikeTech.Converter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmellsLikeTech.Converter.Core\SmellsLikeTech.Converter.Core.csproj" />
  </ItemGroup>
</Project>
