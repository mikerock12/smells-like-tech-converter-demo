<Page
    x:Class="SmellsLikeTech.Converter.Desktop.Pages.StudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BrandBackgroundBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="Space" Invoked="OnPlayAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <TextBlock Text="ESTÚDIO" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                <Button x:Name="DestinationButton" Click="OnChangeDestination" Padding="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DestinationTitle" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="DestinationDetail" FontSize="12" Foreground="{StaticResource BrandTextMutedBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="UndoButton" Content="↶ Desfazer" Click="OnUndo" IsEnabled="False" Visibility="Collapsed" ToolTipService.ToolTip="Desfazer (Ctrl+Z)" />
                <Button x:Name="RedoButton" Content="↷ Refazer" Click="OnRedo" IsEnabled="False" Visibility="Collapsed" ToolTipService.ToolTip="Refazer (Ctrl+Y)" />
                <Button x:Name="OpenProjectButton" Content="Abrir projeto" Click="OnOpenProject" />
                <DropDownButton x:Name="SaveButton" Content="Salvar" Visibility="Collapsed">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Salvar projeto com mídias" Click="OnSaveProjectMenu" />
                            <MenuFlyoutItem Text="Exportar…" Click="OnExportMenu" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="NewProjectButton" Content="Novo projeto" Click="OnNewProject" Visibility="Collapsed" />
                <Button x:Name="CloseProjectButton" Content="✕" Click="OnCloseProject" Visibility="Collapsed" ToolTipService.ToolTip="Fechar ou salvar o projeto" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Margin="0,0,0,10" />
            <!-- Exportação em andamento: a barra fica aqui, sem precisar ir à fila. -->
            <Border x:Name="ExportProgressPanel" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,10" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ExportProgressText" FontSize="13" TextWrapping="WrapWholeWords" />
                        <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ExportQueueButton" Content="Ver na fila" Click="OnExportShowQueue" />
                        <Button x:Name="ExportCancelButton" Content="Cancelar" Click="OnExportCancel" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Assistente: destino e saída. -->
        <ScrollViewer x:Name="WizardView" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="WizardPanel" Spacing="14" MaxWidth="1100" HorizontalAlignment="Left" />
        </ScrollViewer>

        <!-- Editor: prévia à esquerda, abas à direita. -->
        <Grid x:Name="EditorView" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Black" CornerRadius="8" MinHeight="260">
                        <!-- Arrastar move o que está aberto no painel; a roda muda o tamanho. -->
                        <Grid x:Name="PreviewArea" Background="Transparent"
                              PointerPressed="OnPreviewPointerPressed" PointerMoved="OnPreviewPointerMoved"
                              PointerReleased="OnPreviewPointerReleased" PointerCanceled="OnPreviewPointerReleased"
                              PointerWheelChanged="OnPreviewWheel">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <!-- O player fica no lugar do quadro, na proporção do projeto. -->
                            <Viewbox x:Name="PlayerBox" Stretch="Uniform" Visibility="Collapsed">
                                <Grid x:Name="PlayerFrame" Background="Black">
                                    <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="False" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </Viewbox>
                            <Canvas x:Name="GuidesCanvas" IsHitTestVisible="False" />
                            <TextBlock x:Name="EmptyText" Text="Adicione vídeos ou fotos na aba Clipes" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrandTextMutedBrush}" />
                            <ProgressRing x:Name="PreviewRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" />
                            <!-- Montagem da prévia leve: porcentagem, tempo restante e cancelar. -->
                            <Border x:Name="PreviewProgressPanel" VerticalAlignment="Bottom" Margin="12" Padding="12,10" CornerRadius="8"
                                    Background="#E6111116" Visibility="Collapsed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="PreviewProgressText" FontSize="13" TextWrapping="WrapWholeWords" />
                                        <ProgressBar x:Name="PreviewProgressBar" Minimum="0" Maximum="100" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Cancelar" VerticalAlignment="Center" Click="OnCancelPreviewBuild" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="TimeText" FontFamily="Consolas" FontSize="13" />
                        <TextBlock x:Name="TotalText" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Right" Foreground="{StaticResource BrandTextMutedBrush}" />
                    </Grid>
                    <Slider x:Name="TimeSlider" Grid.Row="2" Minimum="0" StepFrequency="0.05" ValueChanged="OnTimeChanged" />
                    <!-- Controles do player: sempre à vista, abaixo da prévia. -->
                    <StackPanel Grid.Row="3" Spacing="6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                            <Button x:Name="PlayerStartButton" Content="⏮" Width="44" Click="OnPlayerStart" ToolTipService.ToolTip="Voltar ao início" />
                            <Button x:Name="PlayerBackButton" Content="−5 s" Width="56" Click="OnPlayerBack" ToolTipService.ToolTip="Voltar 5 segundos" />
                            <Button x:Name="PlayerFrameBackButton" Content="◀|" Width="44" Click="OnPlayerFrameBack" ToolTipService.ToolTip="Quadro anterior" />
                            <Button x:Name="PlayButton" Content="▶ Reproduzir" MinWidth="140" Style="{StaticResource BrandActionButtonStyle}" Click="OnPlayPause" ToolTipService.ToolTip="Reproduzir ou pausar (Ctrl+Espaço)" />
                            <Button x:Name="PlayerFrameForwardButton" Content="|▶" Width="44" Click="OnPlayerFrameForward" ToolTipService.ToolTip="Próximo quadro" />
                            <Button x:Name="PlayerForwardButton" Content="+5 s" Width="56" Click="OnPlayerForward" ToolTipService.ToolTip="Avançar 5 segundos" />
                            <Button x:Name="PlayerEndButton" Content="⏭" Width="44" Click="OnPlayerEnd" ToolTipService.ToolTip="Ir para o fim" />
                        </StackPanel>
                        <TextBlock x:Name="PlayerInfoText" FontSize="12" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" TextAlignment="Center" Foreground="{StaticResource BrandTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Pivot x:Name="EditorPivot" Grid.Column="1">
                <PivotItem Header="Clipes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClipsPanel" Spacing="10" Padding="0,8,8,8" />
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Camadas">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LayersPanel" Spacing="10" Padding="0,8,8,8" />
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Textos">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TextsPanel" Spacing="10" Padding="0,8,8,8" />
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Áudio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AudiosPanel" Spacing="10" Padding="0,8,8,8" />
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Exportar">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ExportPanel" Spacing="10" Padding="0,8,8,8" />
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
