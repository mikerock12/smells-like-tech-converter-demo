<Page
    x:Class="SmellsLikeTech.Converter.Desktop.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SmellsLikeTech.Converter.Desktop.ViewModels"
    Background="{StaticResource BrandBackgroundBrush}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlowCardBorderStyle}">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="HISTÓRICO" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock
                        x:Name="SummaryText"
                        FontSize="12"
                        Foreground="{StaticResource BrandTextMutedBrush}"
                        Text="Somente metadados: nomes, formatos, tamanhos e tempos." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Atualizar" Click="OnRefresh" />
                    <Button Content="Limpar histórico" Click="OnClear" />
                </StackPanel>
            </Grid>
        </Border>

        <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                    <Border
                        Background="{StaticResource BrandPanelBrush}"
                        BorderBrush="{StaticResource BrandStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        AutomationProperties.Name="{x:Bind DisplayName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Glyph="{x:Bind StatusGlyph}"
                                FontSize="16"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource BrandOrangeBrush}" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind Detail}"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Foreground="{StaticResource BrandTextMutedBrush}" />
                                <TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="{StaticResource BrandAmberBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind When}" FontSize="11" Foreground="{StaticResource BrandTextMutedBrush}" />
                                <Button
                                    Tag="{x:Bind OutputPath}"
                                    Click="OnOpenResult"
                                    Visibility="{x:Bind HasOutput}"
                                    Content="Abrir pasta"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
