<Page
    x:Class="SmellsLikeTech.Converter.Desktop.Pages.SpeechPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BrandBackgroundBrush}">

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="TEXTO PARA VOZ" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock
                        Text="O texto fica apenas neste computador: não vai para o banco, nem para os logs."
                        FontSize="12"
                        Foreground="{StaticResource BrandTextMutedBrush}" />
                </StackPanel>

                <TextBox
                    x:Name="TextInput"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    PlaceholderText="Digite ou cole seu texto aqui…"
                    TextChanged="OnTextChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock
                        x:Name="CharacterCountText"
                        FontSize="12"
                        Foreground="{StaticResource BrandTextMutedBrush}"
                        Text="0 caracteres" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Abrir arquivo TXT" Click="OnLoadTextFile" />
                        <Button Content="Limpar" Click="OnClearText" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="VOZ" Style="{StaticResource SectionTitleStyle}" Margin="0" />

                        <StackPanel>
                            <TextBlock Text="Voz Kokoro-82M (offline)" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="VoiceCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <InfoBar
                            x:Name="VoiceWarningBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning"
                            Title="Pacote Kokoro-82M ausente"
                            Message="Reinstale o aplicativo completo, que já inclui as vozes offline." />

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Velocidade" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="RateValueText" Text="0" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{StaticResource BrandAmberBrush}" />
                            </Grid>
                            <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" Value="0" StepFrequency="1"
                                    ValueChanged="OnRateChanged" />
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Volume" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="VolumeValueText" Text="100%" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{StaticResource BrandAmberBrush}" />
                            </Grid>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" StepFrequency="1"
                                    ValueChanged="OnVolumeChanged" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Formato" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bitrate" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="BitrateCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="PreviewButton" Content="Ouvir amostra" Click="OnPreview" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlowCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SAÍDA" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock
                            x:Name="OutputFolderText"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource BrandTextMutedBrush}" />
                        <Button Content="Escolher pasta de saída" Click="OnPickOutputFolder" HorizontalAlignment="Stretch" />
                        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational" />
                        <Button
                            x:Name="GenerateButton"
                            Style="{StaticResource BrandActionButtonStyle}"
                            Click="OnGenerate"
                            AutomationProperties.Name="Gerar áudio da voz">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="GERAR ÁUDIO" FontWeight="Bold" CharacterSpacing="100" />
                                <FontIcon Glyph="&#xE72A;" FontSize="15" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
