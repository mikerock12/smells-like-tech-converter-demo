<Page
    x:Class="SmellsLikeTech.Converter.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SmellsLikeTech.Converter.Desktop.ViewModels"
    Background="{StaticResource BrandBackgroundBrush}">

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left">

            <!-- Pastas -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="PASTAS" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <StackPanel>
                        <TextBlock Text="Pasta base (temporários, cache, modelos, logs)" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RootBox" Grid.Column="0" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Abrir" Click="OnOpenRoot" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Pasta de saída padrão" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" Grid.Column="0" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Alterar" Click="OnPickOutput" />
                            <Button Grid.Column="2" Content="Abrir" Click="OnOpenOutput" />
                        </Grid>
                    </StackPanel>
                    <Button Content="Abrir pasta de logs" Click="OnOpenLogs" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Motores -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="MOTORES" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Caminho do FFmpeg" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="FfmpegBox" PlaceholderText="ffmpeg" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Caminho do FFprobe" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="FfprobeBox" PlaceholderText="ffprobe" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="EngineStatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrandTextMutedBrush}" />
                    <TextBlock x:Name="DocumentToolsText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrandTextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- Hardware -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="HARDWARE" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock x:Name="HardwareText" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel>
                        <TextBlock Text="Aceleração de vídeo" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="AccelerationCombo" HorizontalAlignment="Left" MinWidth="260" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Fila e limites -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="FILA E LIMITES" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Conversões simultâneas" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="ConcurrencyBox" Minimum="1" Maximum="8" Value="2" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Tempo limite por job (min)" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="TimeoutBox" Minimum="1" Maximum="1440" Value="120" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Reserva mínima de disco (GB)" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="DiskReserveBox" Minimum="1" Maximum="4096" Value="20" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Limite de caracteres (voz)" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="TtsLimitBox" Minimum="100" Maximum="200000" Value="20000" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Limite de minutos (transcrição)" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="TranscriptionLimitBox" Minimum="1" Maximum="1440" Value="240" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Guardar jobs com falha (horas)" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="FailedRetentionBox" Minimum="1" Maximum="168" Value="6" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8">
                        <CheckBox x:Name="DeleteTempCheck" Content="Apagar a pasta temporária quando o job terminar bem" />
                        <CheckBox x:Name="KeepFailedCheck" Content="Manter a pasta do job com falha para diagnóstico" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Salvar configurações" Click="OnSave" Style="{StaticResource BrandActionButtonStyle}"
                                HorizontalAlignment="Left" Padding="16,10" />
                        <Button Content="Limpar temporários agora" Click="OnCleanNow" />
                    </StackPanel>
                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Success" />
                </StackPanel>
            </Border>

            <!-- Modelos Whisper -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="MODELOS DE TRANSCRIÇÃO" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock
                        x:Name="ModelsFolderText"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource BrandTextMutedBrush}" />

                    <StackPanel>
                        <TextBlock Text="Modelo usado por padrão nas transcrições" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="DefaultModelCombo" HorizontalAlignment="Left" MinWidth="320" />
                        <TextBlock
                            Text="Modelos maiores acertam mais nomes próprios e sotaque, e demoram mais. Se o escolhido não estiver baixado, a conversão usa o melhor instalado."
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0"
                            Foreground="{StaticResource BrandTextMutedBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" Height="5" CornerRadius="3"
                                 Minimum="0" Maximum="100" Background="#1C1C22"
                                 Foreground="{StaticResource BrandActionBrush}" />
                    <ItemsControl x:Name="ModelList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeechModelItemViewModel">
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Notes}" FontSize="11"
                                                   Foreground="{StaticResource BrandTextMutedBrush}" />
                                        <TextBlock Text="{x:Bind SizeText}" FontSize="11"
                                                   Foreground="{StaticResource BrandAmberBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind Id}" Click="OnDownloadModel" Content="Baixar"
                                                Visibility="{x:Bind CanInstall}" />
                                        <Button Tag="{x:Bind Id}" Click="OnRemoveModel" Content="Remover"
                                                Visibility="{x:Bind IsInstalled}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Licença -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="LICENÇA" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock x:Name="LicenseStatusText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource BrandAmberBrush}" />
                    <TextBlock
                        Text="O aplicativo é pago uma vez só, com licença vitalícia, e começa com 7 dias de teste completo. Compre em converter.smellsliketech.com.br/precos e cole a chave aqui. Ela vale em até 3 computadores seus e é conferida sem internet."
                        FontSize="12" TextWrapping="Wrap"
                        Foreground="{StaticResource BrandTextMutedBrush}" />
                    <StackPanel>
                        <TextBlock Text="Chave da licença" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="LicenseBox" PlaceholderText="SLT1.…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Ativar a licença" Click="OnActivateLicense" Style="{StaticResource BrandActionButtonStyle}"
                                HorizontalAlignment="Left" Padding="16,10" />
                        <Button Content="Remover deste computador" Click="OnRemoveLicense" />
                        <HyperlinkButton NavigateUri="https://converter.smellsliketech.com.br/precos" Content="Comprar a licença" />
                    </StackPanel>
                    <InfoBar x:Name="LicenseBar" IsOpen="False" IsClosable="True" Severity="Success" />
                </StackPanel>
            </Border>

            <!-- Sobre -->
            <Border Style="{StaticResource GlowCardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AboutIcon" Grid.Column="0" Width="84" Height="84" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Smells Like Tech Converter" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandAmberBrush}" />
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource BrandTextMutedBrush}" />
                        <TextBlock Text="© 2026 Smells Like Tech Informática e colaboradores. Clientes integrados sob GPLv3 ou posterior; sem garantia. Direitos de modificar e redistribuir preservados. Licenças completas em kokoro/Licenses."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrandTextMutedBrush}" />
                        <HyperlinkButton NavigateUri="https://github.com/mikerock12/smells-like-tech-converter-demo/releases"
                                         Content="Código-fonte, licença GPL e recompilação" Padding="0,4,0,0" />
                        <TextBlock Text="Criado por Maicon Nunes" FontSize="13" Margin="0,8,0,0" />
                        <TextBlock Text="Smells Like Tech Informática" FontSize="12"
                                   Foreground="{StaticResource BrandOrangeBrush}" />
                        <TextBlock Text="CNPJ 30.054.253/0001-09" FontSize="11"
                                   Foreground="{StaticResource BrandTextMutedBrush}" />
                        <HyperlinkButton NavigateUri="https://www.smellsliketech.com.br"
                                         Content="www.smellsliketech.com.br"
                                         Padding="0,4,0,0"
                                         Foreground="{StaticResource BrandAmberBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
