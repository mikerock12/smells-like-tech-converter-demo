<Application
    x:Class="SmellsLikeTech.Converter.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Paleta da marca, extraída da referência de layout -->
            <Color x:Key="BrandOrangeColor">#FF7A18</Color>
            <Color x:Key="BrandOrangeLightColor">#FFA23A</Color>
            <Color x:Key="BrandAmberColor">#FFC107</Color>
            <Color x:Key="BrandYellowColor">#FFD54A</Color>
            <Color x:Key="BrandBackgroundColor">#05050700</Color>

            <SolidColorBrush x:Key="BrandOrangeBrush" Color="#FF7A18" />
            <SolidColorBrush x:Key="BrandOrangeSoftBrush" Color="#33FF7A18" />
            <SolidColorBrush x:Key="BrandAmberBrush" Color="#FFC107" />
            <SolidColorBrush x:Key="BrandYellowBrush" Color="#FFD54A" />
            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#050507" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#0E0E12" />
            <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#15151B" />
            <SolidColorBrush x:Key="BrandStrokeBrush" Color="#26262F" />
            <SolidColorBrush x:Key="BrandStrokeGlowBrush" Color="#66FF7A18" />
            <SolidColorBrush x:Key="BrandTextBrush" Color="#F3F3F5" />
            <SolidColorBrush x:Key="BrandTextMutedBrush" Color="#A6A6B0" />

            <!-- Acento do sistema em laranja: barras de progresso, seleção e realces -->
            <Color x:Key="SystemAccentColor">#FF7A18</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8E33</Color>
            <Color x:Key="SystemAccentColorLight2">#FFA657</Color>
            <Color x:Key="SystemAccentColorLight3">#FFC48C</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF7A18" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E86D12" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C75B0D" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFA23A" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF8E33" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFC48C" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B0B0D" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1A1A1F" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#050507" />

            <LinearGradientBrush x:Key="BrandActionBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF9A2E" Offset="0" />
                <GradientStop Color="#FF6A00" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrandPanelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#12121A" Offset="0" />
                <GradientStop Color="#0A0A0E" Offset="1" />
            </LinearGradientBrush>

            <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
            <Thickness x:Key="CardPadding">18</Thickness>
            <Thickness x:Key="SectionMargin">0,0,0,14</Thickness>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrandPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
                <Setter Property="Margin" Value="{StaticResource SectionMargin}" />
            </Style>

            <Style x:Key="GlowCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="BorderBrush" Value="{StaticResource BrandStrokeGlowBrush}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource BrandAmberBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource BrandTextMutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="BrandActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandActionBrush}" />
                <Setter Property="Foreground" Value="#0B0B0D" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
