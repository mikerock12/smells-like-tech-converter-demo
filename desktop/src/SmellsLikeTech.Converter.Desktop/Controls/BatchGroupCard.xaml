<UserControl
    x:Class="SmellsLikeTech.Converter.Desktop.Controls.BatchGroupCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SmellsLikeTech.Converter.Desktop.ViewModels"
    xmlns:controls="using:SmellsLikeTech.Converter.Desktop.Controls">

    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="14">

            <!-- Cabeçalho: quantos arquivos são, de que tipo e quanto pesam -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="42"
                    Height="42"
                    CornerRadius="8"
                    Background="#1A1A22"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top">
                    <FontIcon x:Name="KindIcon" FontSize="19" Foreground="{StaticResource BrandOrangeBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="DetailText"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource BrandTextMutedBrush}" />
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="GroupWarningBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning" />

            <!-- A pergunta do lote -->
            <StackPanel x:Name="ModePanel" Spacing="6">
                <Border Height="1" Background="{StaticResource BrandStrokeBrush}" />
                <RadioButton
                    x:Name="SameForAllRadio"
                    Content="Converter todos do mesmo jeito"
                    IsChecked="True"
                    Checked="OnModeChanged" />
                <RadioButton
                    x:Name="OneByOneRadio"
                    Content="Configurar um por um"
                    Checked="OnModeChanged" />
            </StackPanel>

            <!-- Modo um por um: escolhe-se o arquivo, e os campos abaixo passam a ser dele -->
            <StackPanel x:Name="FilePickerPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Arquivo sendo configurado" Style="{StaticResource FieldLabelStyle}" />
                <ListView
                    x:Name="FileList"
                    SelectionMode="Single"
                    MaxHeight="190"
                    SelectionChanged="OnFileChanged"
                    Background="#0B0B10"
                    BorderBrush="{StaticResource BrandStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BatchFileViewModel">
                            <StackPanel Padding="2,6" AutomationProperties.Name="{x:Bind Name}">
                                <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Summary, Mode=OneWay}"
                                    FontSize="11"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{StaticResource BrandTextMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Modo todos iguais: a lista fica só para conferência -->
            <Expander
                x:Name="FileListExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <Expander.Header>
                    <TextBlock x:Name="FileListHeaderText" FontSize="12" />
                </Expander.Header>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlainFileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BatchFileViewModel">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Name}"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Detail}"
                                        FontSize="11"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource BrandTextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>

            <!-- Conversão e presets -->
            <Grid x:Name="OperationPanel" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Conversão" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox
                        x:Name="OperationCombo"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnOperationChanged"
                        DisplayMemberPath="Title" />
                </StackPanel>
                <StackPanel Grid.Column="1" x:Name="PresetPanel" Visibility="Collapsed">
                    <TextBlock Text="Preset" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox
                        x:Name="PresetCombo"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Nenhum"
                        SelectionChanged="OnPresetChanged"
                        DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>

            <controls:ConversionOptionsView x:Name="OptionsView" />
        </StackPanel>
    </Border>
</UserControl>
