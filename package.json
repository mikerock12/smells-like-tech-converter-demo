{
  "name": "smells-like-tech-converter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "postbuild": "node scripts/pwa.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/kokoro*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "motores": "node scripts/copiar-motores.mjs",
    "kokoro:web": "python scripts/kokoro.py web",
    "kokoro:android": "python scripts/kokoro.py android",
    "kokoro:windows": "python scripts/kokoro.py windows",
    "predev": "npm run motores && npm run kokoro:web",
    "prebuild": "npm run motores && npm run kokoro:web"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "libheif-js": "^1.23.2",
    "mediabunny": "^1.59.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "qrcode": "^1.5.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
